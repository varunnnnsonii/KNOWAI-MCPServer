# Semantic Search MCP Server — Environment Configuration
# Copy this file to .env and adjust as needed.

# ---------- Changelog Data ----------
# Path to the directory containing changelog Markdown files.
# Default: ./data/changelogs
CHANGELOG_DIR=./data/changelogs

# ---------- Index Persistence ----------
# Directory where the vector index and BM25 index are persisted.
# Default: ./data
DATA_DIR=./data

# ---------- Embedding Model ----------
# HuggingFace model name for sentence embeddings.
# Default: sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---------- Search Defaults ----------
# Maximum number of results per search query.
# Default: 5
SEARCH_DEFAULT_LIMIT=5

# Maximum allowed limit per query.
# Default: 20
SEARCH_MAX_LIMIT=20

# Minimum similarity score (0.0–1.0) to include in results.
# Default: 0.25
RELEVANCE_THRESHOLD=0.25

# ---------- Logging ----------
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ---------- Server ----------
# MCP server name exposed to clients.
SERVER_NAME=changelog-semantic-search
